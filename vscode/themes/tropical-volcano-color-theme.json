  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8f7a75",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#a88f89",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ffe14d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#fff3ec",
        "fontStyle": ""
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ff5a47"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ff6b9d"
      }
    },
    {
      "name": "Regex / symbol",
      "scope": [
        "string.regexp",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#ff9a8a"
      }
    },
    {
      "name": "Number, boolean, constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ff6b9d"
      }
    },
    {
      "name": "Ruby constant",
      "scope": [
        "variable.other.constant.ruby"
      ],
      "settings": {
        "foreground": "#7ab8ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b48cff"
      }
    },
    {
      "name": "Type, constructor, tag",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.function.constructor",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#7ab8ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#fff3ec"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#9be36a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Special variable (self, this, @ivars)",
      "scope": [
        "variable.language",
        "variable.other.readwrite.instance",
        "variable.other.readwrite.class"
      ],
      "settings": {
        "foreground": "#e8c170"
      }
    },
    {
      "name": "Property, attribute",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "support.type.property-name",
        "meta.property-name",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#cfc3bf"
      }
    },
    {
      "name": "YAML key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#cfc3bf"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#b89e97"
      }
    },
    {
      "name": "Brackets",
      "scope": [
        "meta.brace",
        "punctuation.bracket",
        "punctuation.section",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments"
      ],
      "settings": {
        "foreground": "#ecd8d1"
      }
    },
    {
      "name": "Interpolation punctuation",
      "scope": [
        "punctuation.section.embedded",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#ffe14d"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#ff5a47"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#7ab8ff"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#ffe14d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#fff3ec",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#fff3ec",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#ff9a8a"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8f7a75",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Link URI",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#ff5a47"
      }
    },
    {
      "name": "Link text",
      "scope": [
        "string.other.link.title",
        "string.other.link.description"
      ],
      "settings": {
        "foreground": "#a0f0e0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#9be36a"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff2a1a"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7ab8ff"
      }
    }
  ]
}
