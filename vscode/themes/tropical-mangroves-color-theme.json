  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9a8163",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#b09878",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff7a1a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#fbeede",
        "fontStyle": ""
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ff9fcf"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ffe14d"
      }
    },
    {
      "name": "Regex / symbol",
      "scope": [
        "string.regexp",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#ffc9e4"
      }
    },
    {
      "name": "Number, boolean, constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ffe14d"
      }
    },
    {
      "name": "Ruby constant",
      "scope": [
        "variable.other.constant.ruby"
      ],
      "settings": {
        "foreground": "#ffb347"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#2ad4e8"
      }
    },
    {
      "name": "Type, constructor, tag",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.function.constructor",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ffb347"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#fbeede"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#a8e05f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Special variable (self, this, @ivars)",
      "scope": [
        "variable.language",
        "variable.other.readwrite.instance",
        "variable.other.readwrite.class"
      ],
      "settings": {
        "foreground": "#d8a7ff"
      }
    },
    {
      "name": "Property, attribute",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "support.type.property-name",
        "meta.property-name",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#f0dfbd"
      }
    },
    {
      "name": "YAML key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#f0dfbd"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#c0a582"
      }
    },
    {
      "name": "Brackets",
      "scope": [
        "meta.brace",
        "punctuation.bracket",
        "punctuation.section",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments"
      ],
      "settings": {
        "foreground": "#f0dfc2"
      }
    },
    {
      "name": "Interpolation punctuation",
      "scope": [
        "punctuation.section.embedded",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#ff7a1a"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#ff9fcf"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#2ad4e8"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#ff7a1a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#fbeede",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#fbeede",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#ffc9e4"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9a8163",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Link URI",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#ff9fcf"
      }
    },
    {
      "name": "Link text",
      "scope": [
        "string.other.link.title",
        "string.other.link.description"
      ],
      "settings": {
        "foreground": "#2ad4e8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a8e05f"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff5a36"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#2ad4e8"
      }
    }
  ]
}
