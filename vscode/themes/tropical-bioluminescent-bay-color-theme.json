  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5a7d91",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#7897aa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#b18cff"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#e6f7ff",
        "fontStyle": ""
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#00e5ff"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ffd98a"
      }
    },
    {
      "name": "Regex / symbol",
      "scope": [
        "string.regexp",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#8ff4ff"
      }
    },
    {
      "name": "Number, boolean, constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ffd98a"
      }
    },
    {
      "name": "Ruby constant",
      "scope": [
        "variable.other.constant.ruby"
      ],
      "settings": {
        "foreground": "#ff6be6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#39ffb6"
      }
    },
    {
      "name": "Type, constructor, tag",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.function.constructor",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ff6be6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#e6f7ff"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#ffb38a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Special variable (self, this, @ivars)",
      "scope": [
        "variable.language",
        "variable.other.readwrite.instance",
        "variable.other.readwrite.class"
      ],
      "settings": {
        "foreground": "#7aa8ff"
      }
    },
    {
      "name": "Property, attribute",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "support.type.property-name",
        "meta.property-name",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#cfe8ff"
      }
    },
    {
      "name": "YAML key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#cfe8ff"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#88a9bd"
      }
    },
    {
      "name": "Brackets",
      "scope": [
        "meta.brace",
        "punctuation.bracket",
        "punctuation.section",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments"
      ],
      "settings": {
        "foreground": "#d2e7f2"
      }
    },
    {
      "name": "Interpolation punctuation",
      "scope": [
        "punctuation.section.embedded",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#b18cff"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#00e5ff"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#7aa8ff"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#b18cff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e6f7ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e6f7ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#8ff4ff"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5a7d91",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Link URI",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#00e5ff"
      }
    },
    {
      "name": "Link text",
      "scope": [
        "string.other.link.title",
        "string.other.link.description"
      ],
      "settings": {
        "foreground": "#00e5ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#39ffb6"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff5c7a"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7aa8ff"
      }
    }
  ]
}
